# Copy to .env (repo root) AND to packages/db/.env — the Prisma CLI only
# reads .env from its own directory, not the monorepo root, so
# DATABASE_URL needs to exist in both places. Never commit either real
# .env file (both are gitignored).

# packages/db (Prisma) — Postgres connection string. Use a dedicated
# app-owned role + database (see CLAUDE.md), never the postgres superuser
# and never an existing database from another project.
DATABASE_URL="postgresql://lean_academy:CHANGE_ME@localhost:5432/lean_academy?schema=public"

# apps/web — NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Only needed when running `next start` (production mode) locally, or any
# self-hosted deployment behind a reverse proxy — `next dev` trusts the
# host automatically. Without it Auth.js rejects every request with
# "UntrustedHost". Leave unset on platforms (Vercel, etc.) that set it
# for you.
AUTH_TRUST_HOST=true

# apps/web — OAuth providers (see docs/security.md: official OAuth/PKCE only,
# never ask users for their Google/Facebook password directly)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# apps/api
PORT=4000
