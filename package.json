{
  "name": "lean-academy",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @lean-academy/web dev",
    "dev:mail": "maildev",
    "build": "pnpm -r --filter=./apps/* --filter=./packages/* build",
    "typecheck": "pnpm -r --filter=./apps/* --filter=./packages/* typecheck",
    "test": "pnpm -r --filter=./packages/* test",
    "lint": "pnpm -r --filter=./apps/* --filter=./packages/* lint",
    "db:generate": "pnpm --filter @lean-academy/db generate",
    "db:migrate": "pnpm --filter @lean-academy/db migrate"
  },
  "devDependencies": {
    "maildev": "2.2.1",
    "typescript": "^5.6.3"
  }
}
