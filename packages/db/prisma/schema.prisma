// Normalized schema for the entities listed in project_prompt.txt's
// DATABASE section. A few relation/join tables were added beyond that
// literal list where normalization requires them (ChallengeProgress,
// TaskVersion <-> TaskDefinition) — noted inline.
//
// EvidenceRecord/ResearchCitation mirror data/evidence-registry.json.
// The registry JSON file (loaded via packages/evidence) remains the
// reviewed source of truth that ships with the app; these tables exist
// so the science pages and any future admin tooling can query evidence
// data relationally. Keep them in sync with the registry — see
// docs/evidence-review.md's sync rule in CLAUDE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & account ----------
//
// Account is Auth.js's (NextAuth) standard linked-provider model — it IS
// the "Identity"/"AuthProvider" model project_prompt.txt asks for: one
// row per (provider, providerAccountId), letting a user link Google and
// Facebook to the same account without ever creating a duplicate. Using
// Auth.js's own adapter schema here (rather than a bespoke Identity
// table) means the OAuth/PKCE code paths are the well-tested library
// implementation, not hand-rolled — see docs/security.md's requirement
// for correct OAuth/PKCE. Email+password does not create an Account row
// (Credentials isn't a "linked account" in Auth.js's model); it uses
// User.hashedPassword directly, the standard Auth.js Credentials pattern.

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  /// Set whenever the password changes (currently only by the reset-password
  /// flow). Auth.js's JWT session strategy has no server-side session store
  /// to revoke from, so this is the revocation mechanism instead: the JWT
  /// callback in apps/web/src/lib/auth.ts rejects any session token whose
  /// `iat` predates this timestamp, forcing every other device to sign out
  /// on its next request after a reset.
  passwordChangedAt DateTime?
  /// UI language (a BCP 47 tag from apps/web/src/i18n/config.ts's LOCALES,
  /// e.g. "pl" or "zh-CN"). Null until the user signs up or picks one via
  /// the language switcher. Carried in the session JWT so a new device
  /// with no NEXT_LOCALE cookie still gets the account's language, and
  /// read directly when sending a transactional email (e.g. password
  /// reset) so it arrives in the language the user actually uses.
  locale         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  subscription            Subscription?
  trainingPlans           TrainingPlan[]
  trainingSessions        TrainingSession[]
  difficultyStates        DifficultyState[]
  assessmentResults       AssessmentResult[]
  readingResults          ReadingResult[]
  userAchievements        UserAchievement[]
  challengeProgress       ChallengeProgress[]
  dailyGoal               DailyGoal?
  streak                  Streak?
  xpEntries               XpEntry[]
  devices                 Device[]
  notificationPreference  NotificationPreference?
  exercisePreferences     ExercisePreference[]
  advancedRuns            AdvancedRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

/// Used for both email verification links and password-reset links.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SubscriptionPlan {
  FREE
  PREMIUM_MONTHLY
  PREMIUM_ANNUAL
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// ---------- Training plan & sessions ----------

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
  CUSTOM
  AUTO
}

/// A revision of a user's training direction (from onboarding, or later
/// changed in settings). Kept as a history, not a single mutable row, so
/// the app can show "your plan changed on <date>" if useful later.
model TrainingPlan {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals            Json // string[] of selected goals, see docs/product-requirements.md USER GOALS
  experienceLevel  String? // self-reported onboarding answer, plain text
  difficultyLevel  DifficultyLevel @default(AUTO)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())

  trainingSessions TrainingSession[]

  @@index([userId, active])
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model TrainingSession {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlanId      String?
  trainingPlan        TrainingPlan? @relation(fields: [trainingPlanId], references: [id])
  status              SessionStatus @default(IN_PROGRESS)
  startedAt           DateTime      @default(now())
  completedAt         DateTime?
  totalDurationSeconds Int?

  trials         Trial[]
  readingResults ReadingResult[]
  xpEntries      XpEntry[]

  @@index([userId, startedAt])
}

// ---------- Task catalog & versioning ----------

enum TrainingDomain {
  WORKING_MEMORY
  READING
  SPATIAL
  VERBAL
  COGNITIVE_CONTROL
  MEMORY_STRATEGY
}

/// One row per exercise "family" (e.g. adaptive n-back). The `method`
/// field is the same id used as the `method` key in
/// data/evidence-registry.json — keep them identical.
model TaskDefinition {
  id          String         @id @default(cuid())
  method      String         @unique
  displayName String
  domain      TrainingDomain
  createdAt   DateTime       @default(now())

  versions TaskVersion[]
}

/// Every scientific task must have versions (project_prompt.txt TASK
/// VERSIONING). Trials reference a TaskVersion, never a bare
/// TaskDefinition, so historical scores never silently mix across
/// incompatible stimulus/scoring changes.
model TaskVersion {
  id               String         @id @default(cuid())
  taskDefinitionId String
  taskDefinition   TaskDefinition @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)
  version          String // e.g. "1.3"
  releasedAt       DateTime       @default(now())
  changelog        String?

  trials            Trial[]
  difficultyStates  DifficultyState[]

  @@unique([taskDefinitionId, version])
}

/// The atomic scientific measurement record for reaction-time /
/// accuracy-based tasks. wasInterrupted flags a trial where focus/
/// visibility was lost mid-stimulus (see docs/product-requirements.md's
/// timing-integrity requirement) — exclude these from clean-data analysis
/// rather than deleting them, so the interruption itself stays visible.
model Trial {
  id                  String          @id @default(cuid())
  trainingSessionId   String
  trainingSession     TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  taskVersionId       String
  taskVersion         TaskVersion     @relation(fields: [taskVersionId], references: [id])
  difficultyAtTrial   Int
  correct             Boolean
  reactionTimeMs      Int?
  stimulusStartedAt   DateTime
  respondedAt         DateTime?
  wasInterrupted      Boolean         @default(false)
  /// Task-specific extra data (e.g. n-back N, dice values shown).
  metadata            Json?

  @@index([trainingSessionId])
  @@index([taskVersionId])
}

/// A user's current difficulty per task, persisted so the next session
/// can resume from it instead of restarting the adaptive engine cold.
model DifficultyState {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskVersionId     String
  taskVersion       TaskVersion @relation(fields: [taskVersionId], references: [id])
  currentDifficulty Int
  updatedAt         DateTime    @updatedAt

  @@unique([userId, taskVersionId])
}

// ---------- Assessments (separate from repeated training) ----------

enum AssessmentType {
  BASELINE
  NEAR_TRANSFER
  FAR_TRANSFER
  PERIODIC
}

model Assessment {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        AssessmentType

  results AssessmentResult[]
}

model AssessmentResult {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt      DateTime   @default(now())
  /// Flexible because different assessments produce different measures
  /// (accuracy, span, d-prime, ...) — see docs/product-requirements.md
  /// Performance Metrics.
  scoreSummary Json
  notes        String?

  @@index([userId, assessmentId])
}

// ---------- Reading ----------

enum ReadingSource {
  PUBLIC_DOMAIN
  LICENSED
  AI_GENERATED_VALIDATED
}

model ReadingPassage {
  id              String        @id @default(cuid())
  title           String
  bodyText        String
  genre           String?
  difficultyLevel Int
  wordCount       Int
  source          ReadingSource
  createdAt       DateTime      @default(now())

  questions ReadingQuestion[]
  results   ReadingResult[]
}

enum ReadingQuestionType {
  FACTUAL
  INFERENCE
  MAIN_IDEA
  RELATIONSHIP
  ARGUMENT_STRUCTURE
}

model ReadingQuestion {
  id                 String              @id @default(cuid())
  readingPassageId   String
  readingPassage     ReadingPassage      @relation(fields: [readingPassageId], references: [id], onDelete: Cascade)
  questionText       String
  questionType       ReadingQuestionType
  choices            Json // string[]
  correctChoiceIndex Int
}

/// wpm and comprehensionAccuracy are always stored together and must
/// always be displayed together — see the Reading Science Principle in
/// docs/product-requirements.md. readingEfficiencyScore applies the
/// comprehension-floor formula from that doc; it's nullable because it's
/// only meaningful once enough passages/questions exist for reliability.
model ReadingResult {
  id                     String           @id @default(cuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingSessionId      String?
  trainingSession        TrainingSession? @relation(fields: [trainingSessionId], references: [id])
  readingPassageId       String
  readingPassage         ReadingPassage   @relation(fields: [readingPassageId], references: [id])
  wpm                    Float
  comprehensionAccuracy  Float
  readingEfficiencyScore Float?
  completedAt            DateTime         @default(now())

  @@index([userId, completedAt])
}

// ---------- Gamification ----------

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  description String
  iconKey     String

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())
  /// Contextual detail for achievements that vary by what triggered them
  /// (e.g. Personal Best stores which task: { "method": "..." }).
  metadata      Json?

  @@unique([userId, achievementId])
}

enum XpReason {
  SESSION_COMPLETION
  CONSISTENCY_BONUS
  NEW_DOMAIN_BONUS
  ACHIEVEMENT_BONUS
}

/// One row per XP award (see apps/web/src/lib/xp.ts) rather than a
/// single mutable running total — lets the daily anti-grind cap be
/// computed honestly from real award history instead of a counter that
/// could drift, and keeps a real audit trail of how a user's Training
/// Level was reached.
model XpEntry {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount             Int
  reason             XpReason
  trainingSessionId  String?
  trainingSession    TrainingSession? @relation(fields: [trainingSessionId], references: [id])
  createdAt          DateTime        @default(now())

  @@index([userId, createdAt])
}

model DailyGoal {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetMinutes Int      @default(10)
  updatedAt     DateTime @updatedAt
}

model Streak {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreakDays      Int       @default(0)
  longestStreakDays      Int       @default(0)
  lastActiveDate         DateTime?
  // Streak protection (see apps/web/src/lib/streak.ts): one grace day is
  // spendable to bridge exactly one missed day without breaking the
  // streak. Starts at 1 so a brand-new streak already has protection,
  // and is re-earned (capped at 2) every 7 consecutive active days.
  streakFreezesAvailable Int       @default(1)
  updatedAt              DateTime  @updatedAt
}

enum ChallengeType {
  WEEKLY
  DAILY
}

model Challenge {
  id          String        @id @default(cuid())
  /// Stable template identity (e.g. "complete-sessions") — lets weekly
  /// generation (apps/web/src/lib/weekly-challenges.ts) upsert
  /// idempotently against @@unique([slug, startsAt]) instead of guessing
  /// from title text or reaching into the opaque `criteria` JSON.
  slug        String
  title       String
  description String
  type        ChallengeType
  /// e.g. { "kind": "complete_sessions", "count": 4 }
  criteria    Json
  startsAt    DateTime
  endsAt      DateTime

  /// Join table — not in the spec's literal entity list, but required to
  /// normalize many-users-to-many-challenges participation/progress.
  progress ChallengeProgress[]

  @@unique([slug, startsAt])
}

model ChallengeProgress {
  id            String    @id @default(cuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressValue Int       @default(0)
  completedAt   DateTime?

  @@unique([challengeId, userId])
}

/// A user's saved presentation-parameter customization for one exercise
/// (e.g. inter-stimulus pace, die sides) — never the trained-task logic
/// itself, which stays defined by the exercise's own TaskDefinition and
/// the evidence-gating chain. `method` matches TaskDefinition.method
/// (e.g. "adaptive-nback-v0", "dice-sum-v0"). `settings` is a small,
/// per-method JSON shape owned and validated by
/// apps/web/src/lib/exercise-preferences.ts — kept generic here (one
/// table for every exercise) rather than one column-per-setting model,
/// since each exercise's customizable knobs differ and this project
/// already uses the same "generic Json, typed at the read/write
/// boundary" pattern for Challenge.criteria.
model ExercisePreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    String
  settings  Json
  updatedAt DateTime @updatedAt

  @@unique([userId, method])
}

// One completed Advanced-tab lesson (apps/web/src/lib/advanced-settings.ts).
// Deliberately its own table, never a TrainingSession/Trial row: advanced
// lessons run with user-chosen parameters outside what each exercise's
// evidence base studied, so they must not feed DifficultyState, XP,
// streaks, quests, or /progress. `settings` is the exact parameter set
// the lesson ran with; `summary` holds per-method extras (e.g. reading's
// average WPM alongside its comprehension figure).
model AdvancedRun {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method       String
  settings     Json
  trialCount   Int
  correctCount Int
  startLevel   Int
  endLevel     Int
  summary      Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------- Evidence (relational mirror of data/evidence-registry.json) ----------

enum EvidenceLevel {
  STRONG
  MODERATE
  LIMITED
  EXPERIMENTAL
  UNSUPPORTED
}

model EvidenceRecord {
  id                     String        @id @default(cuid())
  method                 String        @unique // matches TaskDefinition.method
  evidenceLevel          EvidenceLevel
  trainedTaskImprovement String
  nearTransfer           String
  farTransfer            String
  productionApproved     Boolean
  lastReviewed           DateTime

  citations ResearchCitation[]
}

model ResearchCitation {
  id               String         @id @default(cuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  authors          String
  year             Int
  title            String
  venue            String
  url              String
}

// ---------- Devices & notifications (mobile-phase groundwork) ----------

enum DevicePlatform {
  WEB
  IOS
  ANDROID
}

model Device {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([userId])
}

model NotificationPreference {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyReminderEnabled        Boolean  @default(false)
  weeklySummaryEnabled        Boolean  @default(false)
  assessmentReminderEnabled   Boolean  @default(false)
  updatedAt                   DateTime @updatedAt
}
